#!/usr/bin/env bash
set -euo pipefail

if [ -z "${1:-}" ]; then
    echo "Usage: dlmusic [-p] <URL>"
    exit 1
fi

MUSIC_DIR="$HOME/Music"
PLAYLIST_DIR="$MUSIC_DIR/Playlists"
PLAYLIST_FLAG=false
URL=""

# Parse args
while [[ $# -gt 0 ]]; do
    case "$1" in
        -p) PLAYLIST_FLAG=true; shift ;;
        *)  URL="$1"; shift ;;
    esac
done

mkdir -p "$PLAYLIST_DIR"
pushd "$MUSIC_DIR" > /dev/null || exit 1

# ==========================================
# SPOTIFY URL HANDLING (Using spotdl)
# ==========================================
if [[ "$URL" == *"spotify.com"* ]]; then
    echo "Spotify link detected. Utilizing spotdl..."

    SPOTDL_FORMAT_ARGS=(
        "--format" "mp3"
        "--output" "{artist}/{album}/{title}.{output-ext}"
    )

    if $PLAYLIST_FLAG; then
        echo "Fetching exact playlist title from Spotify..."
        
        # Scrape raw title from Spotify metadata
        PL_TITLE=$(curl -sL "$URL" | \
            sed -n 's/.*<meta property="og:title" content="\([^"]*\)".*/\1/p' | \
            sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&amp;/\&/g' -e "s/&#0*39;/'/g" -e 's/&quot;/"/g')
            
        PL_TITLE="${PL_TITLE:-Unknown}"
        
        CLEAN_PL_TITLE=$(echo "$PL_TITLE" | tr '/' '-')
        TARGET_M3U="$PLAYLIST_DIR/$CLEAN_PL_TITLE.m3u"
        TMP_M3U_NAME="temp-spotdl-$(date +%s).m3u"
        
        echo "Preserving internal playlist name: $PL_TITLE"
        echo "Sanitized filename for disk: $CLEAN_PL_TITLE.m3u"

        # Download songs AND write playlist in a SINGLE pass
        spotdl download "$URL" "${SPOTDL_FORMAT_ARGS[@]}" --m3u "Playlists/$TMP_M3U_NAME"

        # Inject #PLAYLIST header and save to sanitized filename
        if [ -f "Playlists/$TMP_M3U_NAME" ]; then
            {
                echo "#EXTM3U"
                echo "#PLAYLIST:$PL_TITLE"
                grep -v '^#EXTM3U' "Playlists/$TMP_M3U_NAME"
            } > "$TARGET_M3U"
            
            rm -f "Playlists/$TMP_M3U_NAME"
            echo "Successfully created playlist: $CLEAN_PL_TITLE.m3u"
        else
            echo "Error: Failed to generate playlist file."
        fi
    else
        spotdl download "$URL" "${SPOTDL_FORMAT_ARGS[@]}"
    fi

    # Extract embedded artwork into cover.jpg (only scanning folders modified in the last 15 mins)
    find . -mmin -15 -type f -name "*.mp3" | while read -r song; do
        album_dir="$(dirname "$song")"
        if [ ! -f "$album_dir/cover.jpg" ]; then
            ffmpeg -y -i "$song" -an -vcodec copy "$album_dir/cover.jpg" >/dev/null 2>&1 || true
        fi
    done
# ==========================================
# STANDARD URL HANDLING (Using yt-dlp)
# ==========================================
else
    echo "Standard link detected. Utilizing yt-dlp..."

    PLAYLIST_ARGS=()
    if $PLAYLIST_FLAG; then
        PL_TITLE=$(yt-dlp --flat-playlist --playlist-items 1 \
            --print "%(playlist_title|Unknown)s" "$URL" 2>/dev/null | head -n1)
        PL_TITLE="${PL_TITLE:-Unknown}"
        
        # Sanitize for Android/FAT32 filesystem restrictions (\ / : * ? " < > |)
	CLEAN_PL_TITLE=$(echo "$PL_TITLE" | tr '/' '-')
	TARGET_M3U="$PLAYLIST_DIR/$CLEAN_PL_TITLE.m3u"

        # Write extended M3U headers including raw playlist title
        {
            echo "#EXTM3U"
            echo "#PLAYLIST:$PL_TITLE"
        } > "$TARGET_M3U"

        PLAYLIST_ARGS+=(
            --no-simulate
            --print-to-file
            "video:../%(artist,uploader|Unknown)s/%(album,playlist_title|Unknown)s/%(title)s.mp3"
            "$TARGET_M3U"
        )
    fi

    yt-dlp -x \
        --audio-format mp3 \
        --audio-quality 0 \
        --embed-metadata \
        --convert-thumbnails jpg \
        --ppa "ThumbnailsConvertor:-vf crop=ih:ih" \
        --ppa "ffmpeg:-id3v2_version 3" \
        --output-na-placeholder "Unknown" \
        --add-metadata \
        --replace-in-metadata "artist" "(?i)(?: feat\.?| ft\.?| &| with| and|,) .*" "" \
        --replace-in-metadata "uploader" "(?i)(?: - Topic| feat\.?| ft\.?| &| with| and|,) .*" "" \
        -o "%(artist,uploader|Unknown)s/%(album,playlist_title|Unknown)s/%(title)s.%(ext)s" \
        --no-overwrites \
        --write-thumbnail \
        -o "thumbnail:%(artist,uploader|Unknown)s/%(album,playlist_title|Unknown)s/cover.%(ext)s" \
        --exec "f=%(filepath)q; rm -f \"\${f%.*}.jpg\"" \
        "${PLAYLIST_ARGS[@]}" \
        "$URL"
fi

popd > /dev/null
mpc update
